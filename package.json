{
  "name": "mssqltop",
  "version": "0.1.0",
  "description": "htop-style terminal activity monitor for Microsoft SQL Server, modeled after the SSMS Activity Monitor",
  "keywords": [
    "mssql",
    "sql-server",
    "sqlserver",
    "top",
    "htop",
    "activity-monitor",
    "monitoring",
    "dba",
    "cli",
    "tui",
    "ink"
  ],
  "license": "MIT",
  "author": "John Chmura",
  "type": "module",
  "bin": {
    "mssqltop": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "odbc": "^2.6.0",
    "react": "^19.3.0",
    "string-width": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "funding": "https://www.buymeacoffee.com/jlchmura"
}
